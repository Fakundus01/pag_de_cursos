SECRET_KEY=change-me
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FRONTEND_PUBLIC_URL=http://127.0.0.1:5173
BACKEND_PUBLIC_URL=http://127.0.0.1:5000
SESSION_COOKIE_NAME=starcraft_academy_session
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=
SESSION_LIFETIME_DAYS=7
PAYMENT_CURRENCY=USD
PAYMENT_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SANDBOX_MODE=true
MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com
ENABLE_DEMO_PAYMENTS=true
SEED_DEMO_USERS=true
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Platform Admin
INITIAL_ADMIN_AVATAR=PA
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_TOKEN_HOURS=24
PASSWORD_RESET_TOKEN_MINUTES=30
EMAIL_DELIVERY_MODE=log
EMAIL_DEV_PREVIEW=true
EMAIL_SUBJECT_PREFIX=Starcraft Academy
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@starcraft.academy
SMTP_FROM_NAME=Starcraft Academy
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_PREVIEW_LOG_PATH=
CSRF_HEADER_NAME=X-CSRF-Token
RATE_LIMIT_SUPPORT_CHAT=18
RATE_LIMIT_SUPPORT_CHAT_WINDOW=60
RATE_LIMIT_AUTH_REGISTER=6
RATE_LIMIT_AUTH_REGISTER_WINDOW=600
RATE_LIMIT_AUTH_LOGIN=10
RATE_LIMIT_AUTH_LOGIN_WINDOW=600
RATE_LIMIT_AUTH_VERIFY_EMAIL=20
RATE_LIMIT_AUTH_VERIFY_EMAIL_WINDOW=3600
RATE_LIMIT_AUTH_RESEND_VERIFICATION=6
RATE_LIMIT_AUTH_RESEND_VERIFICATION_WINDOW=900
RATE_LIMIT_AUTH_PASSWORD_RESET=6
RATE_LIMIT_AUTH_PASSWORD_RESET_WINDOW=900
RATE_LIMIT_AUTH_RESET_PASSWORD=10
RATE_LIMIT_AUTH_RESET_PASSWORD_WINDOW=3600
RATE_LIMIT_CHECKOUT=12
RATE_LIMIT_CHECKOUT_WINDOW=600
RATE_LIMIT_PURCHASE=8
RATE_LIMIT_PURCHASE_WINDOW=600
RATE_LIMIT_DEMO_CONFIRM=20
RATE_LIMIT_DEMO_CONFIRM_WINDOW=300
RATE_LIMIT_PROGRESS=80
RATE_LIMIT_PROGRESS_WINDOW=300
RATE_LIMIT_COMMENTS=12
RATE_LIMIT_COMMENTS_WINDOW=300
RATE_LIMIT_ACTIVITY_GENERATION=24
RATE_LIMIT_ACTIVITY_GENERATION_WINDOW=300
RATE_LIMIT_ADMIN_WRITE=30
RATE_LIMIT_ADMIN_WRITE_WINDOW=600
FLASK_DEBUG=false

# Local development
DATABASE_URL=sqlite:///academy.db

